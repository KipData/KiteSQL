statement ok
create table t(id int primary key,v1 int not null, v2 int not null, v3 double not null)

statement ok
insert into t values(0,1,4,2.5), (1,2,3,3.2), (2,3,4,4.7), (3,4,3,5.1)

query I
select sum(v1) + sum(v2) from t
----
24

query I
select sum(v1) as a from t
----
10

query IR
select sum(v1), sum(v3) from t
----
10 15.5

query IR
select sum(v1+v2),sum(v1+v3) from t
----
24 25.5

# SimpleMinTest

query I
select min(v1) from t
----
1

# SimpleMaxTest

query I
select max(v1) from t
----
4

# SimpleMaxTest1

query I
select max(v1) from t where v2>3
----
3

# SimpleCountTest

query I
select count(v1) from t
----
4

# SimpleAvgTest

query R
select avg(v2) from t
----
3.5

# SumGroupTest

query II rowsort
select sum(v1), v2 from t group by v2
----
4 4
6 3

query II
select sum(v1) as a, v2 from t group by v2 order by a
----
4 4
6 3

statement ok
drop table t

# sum(NULL) is NULL, not an assertion failure.
statement ok
create table sn(id int primary key, a int);

statement ok
insert into sn values (1, 1), (2, 2);

query I
select sum(null) from sn;
----
NULL

query I
select sum(distinct null) from sn;
----
NULL

query I
select (select sum(null) from sn) from sn where id = 1;
----
NULL

# Aggregates, including SELECT aliases containing aggregates, cannot run in WHERE.
statement error agg miss: aggregate functions are not allowed in WHERE
select count(*) as n from sn where n is not null;

statement error agg miss: aggregate functions are not allowed in WHERE
select + + 23 * + count(*) * - + 69 as n from sn where not n is null;

statement error agg miss: aggregate functions are not allowed in WHERE
select count(*) as n from sn where coalesce(n, 0) > 0;

statement error agg miss: aggregate functions are not allowed in WHERE
select id from sn where count(*) > 0;

query I
select count(*) as n from sn having n > 0;
----
2

query I
select count(*) from sn where a > 0;
----
2

statement ok
drop table sn
