statement ok
create table t2(id int primary key, v1 varchar, v2 varchar(5 characters), v3 varchar(5 octets))

statement ok
insert into t2 values(0, '🪁', '🪁🪁🪁🪁🪁', '🪁');

statement ok
insert into t2 values(1, null, null, null);

statement error
insert into t2 values(1, '🪁', '🪁🪁🪁🪁🪁🪁', '🪁');

statement error
insert into t2 values(1, '🪁', '🪁🪁🪁🪁🪁', '🪁🪁');

query ITT
