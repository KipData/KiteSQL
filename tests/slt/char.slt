query TTT
select +v1, ++v2, +v3 from t1 order by id;
----
🪁 🪁🪁🪁🪁🪁 🪁
NULL NULL NULL

query TTT
select +v1, ++v2, +v3 from t2 order by id;
----
🪁 🪁🪁🪁🪁🪁 🪁
NULL NULL NULL

query TTT
select +'abc', +'12', +cast('abc' as char(3));
----
abc 12 abc

query I
select id from t2 where +v1 is null;
----
1

statement error
select -v1 from t2;

# Eliminating unary + must not silently accept non-numeric/non-text types.
statement error unsupported unary operator
select +true;

statement error unsupported unary operator
select +cast('2024-01-01' as date);

statement ok
drop table t1;

statement ok
drop table t2;

# String length functions.
# char_length / octet_length: integer result, NULL in -> NULL out.

statement ok
create table s(id int primary key, c varchar);

statement ok
insert into s values (1, 'ab'), (2, 'abcd'), (3, null);

query R
select avg(char_length(c)) from s;
----
3.0

query I
select sum(octet_length(c)) from s;
----
6

query I rowsort
select id from s where char_length(c) = 2;
----
1

query I rowsort
select id from s where char_length(c) + 1 > 3;
----
2

query I
select char_length(c) from s where id = 3;
----
NULL

statement ok
drop table s
