# The prefix scan rechecks full values before applying LIMIT/OFFSET.
statement ok
create table prefix_scan (id int primary key, b char(8));

statement ok
create index b_prefix on prefix_scan (b(2));

statement ok
insert into prefix_scan values (1, 'abA'), (2, 'abB'), (3, 'abB'), (4, 'ac'), (5, 'ad'), (6, 'ae'), (7, 'af'), (8, 'ag');

statement ok
analyze table prefix_scan;

query T
explain select id, b from prefix_scan where b = 'abB' limit 1 offset 1;
----
Projection [prefix_scan.id, prefix_scan.b] [Project => (Sort Option: Follow)] Limit 1, Offset 1 [Limit => (Sort Option: Follow)] TableScan prefix_scan -> [prefix_scan.id, prefix_scan.b], Filter: (cast (prefix_scan.b as Varchar(None, CHARACTERS)) = abB) [IndexScan By b_prefix => abB => (Sort Option: None)]

query IT
select id, b from prefix_scan where b = 'abB' limit 1 offset 1;
----
3 abB

statement ok
drop table prefix_scan;

# Binary prefixes enforce byte-based uniqueness during backfill and writes.
statement ok
create table prefix_binary (id int primary key, b varbinary(10), g int);

statement ok
