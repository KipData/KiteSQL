statement ok
drop index idx_ts on t_func_default;

statement ok
alter table t_func_default drop column v;

statement ok
insert into t_func_default (id) values (1);

query B
select ts is not null from t_func_default;
----
true

statement ok
drop table t_func_default;

# String prefixes count characters, not bytes.
statement ok
