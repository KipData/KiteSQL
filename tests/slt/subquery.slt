query II
select id, (select count(*) from sq_ref) - id as x from sq_ref order by x;
----
2 1
1 2
0 3

query I
select (select max(id) from sq_ref) + 1 as x from sq_ref order by x;
----
3
3
3

query I
select distinct (select max(id) from sq_ref) from sq_ref;
----
2

query I
select (select max(id) from sq_ref) as x from sq_ref group by x;
----
2

# Not referenced by those clauses: still supported.
query II
select id, (select max(id) from sq_ref) as x from sq_ref order by id;
----
0 2
1 2
2 2

query II
select (select max(id) from sq_ref), count(*) from sq_ref;
----
2 3

query T rowsort
select distinct c from sq_ref where id < (select max(id) from sq_ref);
----
a
b

statement ok
drop table sq_ref;

