# Correlated values use the execution arena; outer columns remain input dependencies.
statement ok
create table corr_rows(id int primary key, b int);

statement ok
insert into corr_rows values (1,10),(2,20),(3,30),(4,null),(5,20);

# WHERE and SELECT registrations are attached before their own consumers.
query T
explain select id,(select 7) from corr_rows where b<(select 25);
----
Projection [corr_rows.id, InitValue(1:0)] [Project => (Sort Option: Follow)] ScalarQueryInit InitValue(1:0) Filter (corr_rows.b < InitValue(1:1)), Is Having: false [Filter => (Sort Option: Follow)] ScalarQueryInit InitValue(1:1) TableScan corr_rows -> [corr_rows.id, corr_rows.b] [SeqScan => (Sort Option: None)] ScalarSubquery [ScalarSubquery => (Sort Option: Follow)] Projection [25] [Project => (Sort Option: Follow)] Dummy [Dummy => (Sort Option: None)] ScalarSubquery [ScalarSubquery => (Sort Option: Follow)] Projection [7] [Project => (Sort Option: Follow)] Dummy [Dummy => (Sort Option: None)]

query II rowsort
select id,(select 7) from corr_rows where b<(select 25);
----
1 7
2 7
5 7

# b is needed solely as an outer parameter, not as a projected output column.
query I rowsort
select (select count(*) from corr_rows x where x.b<corr_rows.b) from corr_rows;
----
0
0
1
1
3

query II rowsort
select (select count(*) from corr_rows x where x.b<corr_rows.b),(select 7) from corr_rows where b<(select 25);
----
0 7
1 7
1 7

query II rowsort
select (select x.b from corr_rows x where x.id=corr_rows.id+100),coalesce((select x.b from corr_rows x where x.id=corr_rows.id),-1) from corr_rows;
----
NULL -1
NULL 10
NULL 20
NULL 20
NULL 30

# LIMIT without sorting streams input; sorting preserves each row's scalar values.
query I rowsort
select (select count(*) from corr_rows x where x.b<corr_rows.b) from corr_rows limit 2;
----
0
1

# Multiple scalar results and a statement constant must survive sorting together.
query IIII
select id,(select count(*) from corr_rows x where x.b<corr_rows.b),(select count(*) from corr_rows x where x.b>corr_rows.b),(select 7) from corr_rows order by id desc limit 3 offset 1;
----
4 0 0 7
3 3 0 7
2 1 1 7

# Null/text scalar results are paired with the original rows after ordering.
query IT
select id,(select cast(x.b as varchar(12)) from corr_rows x where x.id=corr_rows.id and x.id<>2) from corr_rows order by id desc;
----
5 20
4 NULL
3 30
2 NULL
1 10

query II rowsort
select id,(select count(*) from corr_rows x where x.b<corr_rows.b) as n from corr_rows;
----
1 0
2 1
3 3
4 0
5 1

query II
select id,(select count(*) from corr_rows x where x.b<corr_rows.b) as n from corr_rows order by n desc,id limit 3;
----
3 3
2 1
5 1

statement error correlated scalar values across DISTINCT require a row-scoped execution context
select distinct (select count(*) from corr_rows x where x.b<corr_rows.b) from corr_rows;

query III rowsort
select id,(select count(*) from corr_rows x where x.b<corr_rows.b),(select count(*) from corr_rows x where x.b>corr_rows.b) from corr_rows;
----
1 0 3
2 1 1
3 3 0
4 0 0
5 1 1

query II rowsort
select o.id,(select count(*) from corr_rows x where x.b>o.b and x.id<o.id) from corr_rows o;
----
1 0
2 0
3 0
4 0
5 1

query II rowsort
