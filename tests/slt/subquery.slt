select count(*),(select max(x.b) from corr_rows x where x.id<corr_rows.id) from corr_rows;

statement ok
create view corr_view as select id,(select count(*) from corr_rows x where x.b<corr_rows.b) as n from corr_rows;

query II
select a.id,a.n+b.n from corr_view a join corr_view b on a.id=b.id order by a.id;
