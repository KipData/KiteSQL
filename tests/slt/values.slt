query I
SELECT * FROM (VALUES (1), (2), (3));
----
1
2
3

query IT
SELECT * FROM (VALUES (1, 'a'), (2, 'b'), (3, 'c'));
----
1 a
2 b
3 c

query II
SELECT * FROM (VALUES (1, 2)) AS t(x, y);
----
1 2

query I rowsort
SELECT * FROM (VALUES (4), (5), (6)) LIMIT 2;
----
4
5

query I
SELECT * FROM (VALUES (1), (NULL), (3));
----
1
null
3

statement ok
CREATE TABLE t (x INT PRIMARY KEY);

statement ok
INSERT INTO t VALUES (1), (2), (3);

# Regression: wildcard expansion over a joined VALUES source should keep the
# visible output shape instead of duplicating the join key column.
query I rowsort
SELECT * FROM t JOIN (VALUES (2), (3)) AS v(x) ON t.x = v.x;
----
2
3

query I
SELECT * FROM (VALUES (1), (2.5));
----
1.0
2.5

query I rowsort
SELECT * FROM (VALUES (1), (2)) UNION SELECT * FROM (VALUES (2), (3));
----
1
2
3

query I
SELECT * FROM (VALUES (3), (1), (2)) AS v(x) ORDER BY v.x ASC;
----
1
2
3

query I
SELECT t.y FROM (VALUES (10, 20), (30, 40)) AS t(x, y);
----
20
40

statement ok
ALTER TABLE t ADD COLUMN v INT NOT NULL DEFAULT 7;

statement ok
INSERT INTO t VALUES (4, DEFAULT), (4 + 1, 21), (10, DEFAULT), (10 + 1, 30);

query II
SELECT * FROM t ORDER BY x;
----
1 7
2 7
3 7
4 7
5 21
10 7
11 30

statement ok
DROP TABLE t;
