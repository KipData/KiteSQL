# F261-01: Simple CASE

query I
SELECT CASE 0 WHEN 2 THEN 1 ELSE 1 END
----
1

query I
SELECT CASE 0 WHEN 2 THEN 1 ELSE NULL END
----
NULL

query I
SELECT CASE 0 WHEN 2 THEN 1 END
----
NULL

query I
SELECT CASE 0 WHEN 2 THEN NULL ELSE 1 END
----
1

query I
SELECT CASE 0 WHEN 2 THEN NULL ELSE NULL END
----
NULL

query I
