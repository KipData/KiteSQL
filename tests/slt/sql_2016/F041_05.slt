# F041-05: Outer joins can be nested

statement ok
CREATE TABLE TABLE_F041_05_01_011 ( ID INT PRIMARY KEY, A INTEGER );

statement ok
CREATE TABLE TABLE_F041_05_01_012 ( ID INT PRIMARY KEY, A INTEGER );

statement ok
CREATE TABLE TABLE_F041_05_01_013 ( ID INT PRIMARY KEY, A INTEGER );

query I
SELECT TABLE_F041_05_01_011.A FROM TABLE_F041_05_01_011 LEFT JOIN TABLE_F041_05_01_012 ON TABLE_F041_05_01_011.A = TABLE_F041_05_01_012.A LEFT JOIN TABLE_F041_05_01_013 ON TABLE_F041_05_01_012.A = TABLE_F041_05_01_013.A

statement ok
drop table table_f041_05_01_011

statement ok
drop table table_f041_05_01_012

statement ok
