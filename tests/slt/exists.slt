statement ok
CREATE TABLE t1 (id INT PRIMARY KEY, val INT);

statement ok
CREATE TABLE t2 (id INT PRIMARY KEY);

statement ok
INSERT INTO t1 VALUES (1, 10), (2, 20), (3, 30);

statement ok
INSERT INTO t2 VALUES (1), (3);

query II
SELECT id, val FROM t1 WHERE EXISTS (SELECT 1 FROM t2)
----
1 10
2 20
3 30

query II
SELECT id, val FROM t1 WHERE EXISTS (SELECT 1 FROM t2 WHERE 1 = 0)
----

query II
SELECT id, val FROM t1 WHERE NOT EXISTS (SELECT 1 FROM t2)
----


query II
SELECT id, val FROM t1 WHERE NOT EXISTS (SELECT 1 FROM t2 WHERE 1 = 0)
----
1 10
2 20
3 30

statement ok
drop table t1

statement ok
drop table t2

# A table alias hides the table name, and a correlated EXISTS keeps the alias identity of its
# columns, so non-equality correlations compare inner and outer rows.
statement ok
create table t_corr(pk int primary key, b int)

statement ok
insert into t_corr values (0, 10), (1, 20), (2, 30), (3, null)

statement error
select t_corr.b from t_corr as x

query I rowsort
select b from t_corr where exists(select 1 from t_corr as x where x.b < t_corr.b)
----
20
30

query I rowsort
select b from t_corr where exists(select 1 from t_corr as x where x.b = t_corr.b)
----
10
20
30

query I rowsort
select y.b from t_corr as y where exists(select 1 from t_corr as x where x.b > y.b)
----
10
20

query I rowsort
select b from t_corr where not exists(select 1 from t_corr as x where x.b < t_corr.b)
----
10
NULL

statement ok
drop table t_corr
