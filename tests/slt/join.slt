8 -1

query II rowsort
select coalesce(a.id, -1), coalesce(b.id, -1) from hj_empty a full join hj_right b on a.k = b.k and a.id < b.id;
----
-1 0
-1 10
-1 11
-1 3
-1 5
-1 9

