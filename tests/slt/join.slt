2000 20 200

query III rowsort
select a.v,b.v,c.v from greedy_a a left join greedy_b b on a.k=b.k left join greedy_c c on b.k=c.k where a.id<100
----
10 100 1000
10 100 1100
20 200 2000
30 NULL NULL
40 NULL NULL
50 NULL NULL
60 NULL NULL

# A comma join initially contains a CrossJoin without a direct a/b key.
query III rowsort
select greedy_a.v,greedy_b.v,greedy_c.v from greedy_a,greedy_b,greedy_c where greedy_a.k=greedy_c.k and greedy_b.k=greedy_c.k
----
10 100 1000
10 100 1100
20 200 2000

