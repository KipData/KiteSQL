# Greedy reorder must preserve output slots, duplicate matches and NULL equality.
statement ok
create table greedy_a(id int primary key, k int, v int)

statement ok
create table greedy_b(id int primary key, k bigint, v int)

statement ok
create table greedy_c(id int primary key, k int, v int)

statement ok
insert into greedy_a values (1,1,10),(2,2,20),(3,3,30),(4,NULL,40),(5,5,50),(6,6,60)

statement ok
insert into greedy_b values (1,1,100),(2,2,200)

statement ok
insert into greedy_c values (1,1,1000),(2,1,1100),(3,2,2000)

statement ok
insert into greedy_a select cast(number+100 as int),cast(-number-1000 as int),0 from table(numbers(300))

statement ok
insert into greedy_b select cast(number+100 as int),-number-2000,0 from table(numbers(100))

statement ok
insert into greedy_c select cast(number+100 as int),cast(-number-3000 as int),0 from table(numbers(200))

statement ok
analyze table greedy_a

statement ok
analyze table greedy_b

statement ok
analyze table greedy_c

query T
explain select a.v,b.v,c.v from greedy_a a join greedy_b b on a.k=b.k join greedy_c c on b.k=c.k
----
Projection [a.v, b.v, c.v] [Project => (Sort Option: Follow)] Inner Join On cast (a.k as Bigint) = b.k [HashJoin => (Sort Option: None)] Projection [(greedy_a.k) as (a.k), (greedy_a.v) as (a.v)] [Project => (Sort Option: Follow)] TableScan greedy_a -> [greedy_a.k, greedy_a.v] [SeqScan => (Sort Option: None)] Inner Join On b.k = cast (c.k as Bigint) [HashJoin => (Sort Option: None)] Projection [(greedy_b.k) as (b.k), (greedy_b.v) as (b.v)] [Project => (Sort Option: Follow)] TableScan greedy_b -> [greedy_b.k, greedy_b.v] [SeqScan => (Sort Option: None)] Projection [(greedy_c.k) as (c.k), (greedy_c.v) as (c.v)] [Project => (Sort Option: Follow)] TableScan greedy_c -> [greedy_c.k, greedy_c.v] [SeqScan => (Sort Option: None)]

query III rowsort
select a.v,b.v,c.v from greedy_a a join greedy_b b on a.k=b.k join greedy_c c on b.k=c.k
----
10 100 1000
10 100 1100
20 200 2000

# A materializing derived input can drive a CrossJoin without changing output slots.
query III rowsort
select a.v,h.bv,h.cv from greedy_a a cross join (select b.v as bv,c.v as cv from greedy_b b join greedy_c c on b.k=c.k) h where a.id<=2
----
10 100 1000
10 100 1100
10 200 2000
20 100 1000
20 100 1100
20 200 2000

query III
select a.v,h.bv,h.cv from greedy_a a cross join (select b.v as bv,c.v as cv from greedy_b b join greedy_c c on b.k=c.k) h where a.id<=2 order by a.v desc,h.cv desc limit 3
----
20 200 2000
20 100 1100
20 100 1000

# The smallest inputs b and c have no direct key; apply both keys when a joins.
