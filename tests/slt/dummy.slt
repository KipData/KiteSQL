statement error
SELECT *

# CASE branches of different types are unified (e.g. bigint / int => bigint),
# and unary operators on NULL yield NULL, as in PostgreSQL.
statement ok
create table case_ty(id int primary key, a int, b bigint, d double);

statement ok
insert into case_ty values (1, 1, 2, 1.5);

query I
select case when id > 0 then b else 1 end from case_ty;
----
2

query R
select case when id > 0 then b else 1.5 end from case_ty;
----
2.0

query I
select (case when id > 0 then b else 1 end) + 1 from case_ty;
----
3

query T
select (case when id > 0 then b else 1 end) = 2 from case_ty;
----
true

query I
select - (null) from case_ty;
----
NULL

query T
select 3 = - null from case_ty;
----
NULL

statement ok
drop table case_ty
